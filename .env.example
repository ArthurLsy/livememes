# --- Discord ---------------------------------------------------------------
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Onglet "General Information" -> Application ID
DISCORD_CLIENT_ID=
# Optionnel : deploie les commandes sur ce seul serveur (elles apparaissent
# instantanement au lieu d'attendre jusqu'a 1h pour un deploiement global).
DISCORD_DEV_GUILD_ID=
# Deploie les slash commands au demarrage du serveur, au lieu de lancer
# `npm run commands:deploy` a la main. Utile sur un PaaS type Coolify. Laisse a
# false une fois le premier deploiement fait : Discord plafonne la creation de
# commandes globales a 200/jour.
DEPLOY_COMMANDS_ON_BOOT=false

# --- Backend ---------------------------------------------------------------
PORT=8787
# URL publique du backend. C'est elle qui est envoyee aux overlays : depuis une
# autre machine, "localhost" ne marchera pas. Utilise un domaine ou un tunnel.
PUBLIC_URL=http://localhost:8787
# Nombre de reverse proxys devant le backend (Traefik/Coolify : 1). Sert a lire
# la vraie IP du client pour la limite anti brute-force de /api/pair. Laisse
# vide si le backend est expose en direct : sinon n'importe qui peut falsifier
# son IP via X-Forwarded-For. Accepte aussi true ou une liste d'IP/sous-reseaux.
TRUST_PROXY=

# --- Reglages ---------------------------------------------------------------
# Role requis pour envoyer ET recevoir des memes. Vide = tout le monde y a droit.
# Pour l'id : Parametres Discord > Avance > Mode developpeur, puis Parametres du
# serveur > Roles > clic droit sur le role > Copier l'identifiant.
DROP_ROLE_ID=
# Domaines autorises pour le telechargement des medias, separes par des virgules
# (sous-domaines compris). Vide = tout domaine public. Si tu le remplis, garde
# cdn.discordapp.com et media.discordapp.net, sinon /meme fichier ne marche plus.
# Les adresses internes (localhost, reseau prive, 169.254.x) sont toujours refusees.
MEDIA_ALLOWED_HOSTS=
MEDIA_MAX_BYTES=26214400
MEDIA_TTL_HOURS=24
DROP_DEFAULT_DURATION_MS=6000
DROP_MAX_DURATION_MS=20000
# Une video est jouee une fois jusqu'a la fin, puis disparait. Ce plafond coupe
# les videos plus longues et sert de filet si une video reste bloquee. L'option
# `duree` de /meme, si elle est donnee, devient le plafond de la video.
DROP_MAX_VIDEO_DURATION_MS=60000
DROP_COOLDOWN_MS=8000
