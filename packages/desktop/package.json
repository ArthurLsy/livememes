{
  "name": "@livememes/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Overlay LiveMemes",
  "author": "ArthurLsy",
  "repository": "https://github.com/ArthurLsy/livememes",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch --start",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "art": "node scripts/installer-art.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@livememes/shared": "*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "electron": "44.1.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.27.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "app.livememes.overlay",
    "productName": "LiveMemes",
    "icon": "assets/icon.png",
    "files": ["dist/**/*", "assets/**/*"],
    "directories": { "output": "release" },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "publish": { "provider": "github", "owner": "ArthurLsy", "repo": "livememes" },
    "mac": { "category": "public.app-category.entertainment", "target": ["dmg", "zip"] },
    "dmg": {
      "background": "build/background.png",
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 130, "y": 180, "type": "file" },
        { "x": 410, "y": 180, "type": "link", "path": "/Applications" }
      ]
    },
    "win": { "target": ["nsis", "zip"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "executableName": "livememes",
      "maintainer": "ArthurLsy <ArthurLsy@users.noreply.github.com>"
    }
  }
}
